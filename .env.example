# OpenAI API
OPENAI_API_KEY=your-openai-api-key

# Redis
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=sqlite:///./opus.db

# TikTok API
TIKTOK_API_KEY=your-tiktok-api-key
TIKTOK_SECRET_KEY=your-tiktok-secret-key

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key

# Instagram API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Proxy Configuration
PROXY_ENABLED=False
PROXY_LIST=

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# Processing
FFMPEG_PATH=ffmpeg
FPS=30
